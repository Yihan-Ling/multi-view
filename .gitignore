# Data — keep schema/metadata in repo, exclude bulk.
# Anchored to repo root so source dirs like multi_view/data/ and scripts/data/
# are NOT ignored.
/data/
!/data/.gitkeep
!/data/README.md

# Models — same idea
/models/
!/models/.gitkeep
!/models/README.md

